{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "designstack/subscribe",
	"title": "Подписка на дайджест",
	"category": "designstack",
	"icon": "email-alt",
	"description": "Блок подписки в Telegram. Пока в настройках нет адреса канала, блок ничего не выводит.",
	"textdomain": "designstack-core",
	"attributes": {
		"variant": {
			"type": "string",
			"default": "block"
		},
		"onlyCategory": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./editor.js"
}
