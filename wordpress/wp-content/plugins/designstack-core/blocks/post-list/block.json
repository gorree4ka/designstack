{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "designstack/post-list",
	"title": "Карточки записей",
	"category": "designstack",
	"icon": "grid-view",
	"description": "Подборки, выпуски или обзоры карточками со ссылкой «все». Записей нет — блока нет.",
	"textdomain": "designstack-core",
	"attributes": {
		"category": {
			"type": "string",
			"default": "collections"
		},
		"variant": {
			"type": "string",
			"default": "fresh"
		}
	},
	"supports": {
		"html": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./editor.js"
}
